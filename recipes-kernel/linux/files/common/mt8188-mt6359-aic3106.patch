+/*
+ * TLV320AIC3106 is connected to ETDM2 via I2S.
+ * The board wires ETDM2_OUT MCLK directly to the codec MCLK input.
+ *
+ * Keep the original 128fs setting for other codecs. For AIC3106,
+ * program both CPU and codec DAIs with the same 256fs MCLK.
+ * Note: this configures the clock rate, but cannot by itself guarantee
+ * the ETDM2_OUT MCLK remains enabled during capture-only streams.
+ */
+static int mt8188_aic3106_hw_params(struct snd_pcm_substream *substream,
+				    struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct snd_soc_card *card = rtd->card;
+	struct snd_soc_dai *cpu_dai = asoc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai = asoc_rtd_to_codec(rtd, 0);
+	unsigned int rate = params_rate(params);
+	unsigned int mclk = rate * 256;
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, 0, mclk,
+				     SND_SOC_CLOCK_OUT);
+	if (ret) {
+		dev_err(card->dev,
+			"AIC3106 %s: failed to set CPU MCLK %u Hz: %d\n",
+			rtd->dai_link->name, mclk, ret);
+		return ret;
+	}
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, 0, mclk,
+				     SND_SOC_CLOCK_IN);
+	if (ret) {
+		dev_err(card->dev,
+			"AIC3106 %s: failed to set codec MCLK %u Hz: %d\n",
+			rtd->dai_link->name, mclk, ret);
+		return ret;
+	}
+
+	dev_info(card->dev, "AIC3106 %s: rate=%u Hz, MCLK=%u Hz\n",
+		 rtd->dai_link->name, rate, mclk);
+
+	return 0;
+}
+
+static const struct snd_soc_ops mt8188_aic3106_ops = {
+	.hw_params = mt8188_aic3106_hw_params,
 };
 
